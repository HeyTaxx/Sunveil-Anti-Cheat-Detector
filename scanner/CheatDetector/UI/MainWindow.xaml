<Window x:Class="CheatDetector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SUNVEIL OVERWATCH — System Diagnostic Console" 
        Height="680" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#060609"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, sans-serif"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Primary Action Button with Emerald to Blue Gradient -->
        <Style x:Key="GradientButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0.0"/>
                                    <GradientStop Color="#3B82F6" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F0F17" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0.0"/>
                            <GradientStop Color="#3B82F6" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SUNVEIL " FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="OVERWATCH" FontSize="18" FontWeight="ExtraBold" Foreground="#10B981"/>
                    </StackPanel>
                    <TextBlock Text="Advanced Forensic PC Analysis • Blue Style Development" FontSize="12" Foreground="#9CA3AF"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AdminBadge" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="AdminBadgeText" Text="Standard Mode" FontSize="12" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                    </Border>
                    <Button Click="OpenLegalTermsButton_Click" Style="{StaticResource SecondaryButtonStyle}" Content="📜 Terms &amp; Privacy" Padding="10,4" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- 1. START PANEL -->
            <Grid x:Name="StartPanel" Visibility="Visible">
                <Border Background="#0F0F17" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="14" Padding="32">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="System Integrity Diagnostic Console" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="This security tool performs an automated, read-only forensic inspection of your system to verify game integrity for Sunveil SMP. It checks running processes, memory strings, execution history, temporary files, and storage volumes for cheat clients and evasion attempts." 
                                   FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,24"/>

                        <Border Background="#060609" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Operational Guidelines:" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>
                                <TextBlock Text="• Fully Automated: Runs a complete 8-step forensic scan without manual intervention." FontSize="13" Foreground="#D1D5DB" Margin="0,3"/>
                                <TextBlock Text="• Background Execution: You can minimize this window to the System Tray at any time." FontSize="13" Foreground="#D1D5DB" Margin="0,3"/>
                                <TextBlock Text="• Reference Code: Generates a reference ID to share with server staff upon completion." FontSize="13" Foreground="#D1D5DB" Margin="0,3"/>
                                <TextBlock Text="• Anti-Evasion Notice: Deleting cheat software prior to scanning is logged as an evasion attempt." FontSize="13" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Legal Agreement Notice -->
                        <CheckBox x:Name="LegalConsentCheckBox" Content="I accept the Terms of Service &amp; Privacy Policy (bluestyle.dev / Sunveil SMP)" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Button x:Name="StartScanButton" Click="StartScanButton_Click" Style="{StaticResource GradientButtonStyle}" Content="🚀 Start System Scan" Height="52" HorizontalAlignment="Center" Width="260"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. SCANNING PANEL -->
            <Grid x:Name="ScanningPanel" Visibility="Collapsed">
                <Border Background="#0F0F17" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="14" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Step Info Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StepNumberText" Text="Step 1 of 8: " FontSize="17" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="CurrentStepText" Text="Process &amp; RAM Analysis" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="ElapsedTimeText" Text="Elapsed: 00:00" FontSize="13" Foreground="#9CA3AF" Margin="0,0,16,0"/>
                                <TextBlock x:Name="TimeRemainingText" Text="Est. Remaining: ~25s" FontSize="13" FontWeight="SemiBold" Foreground="#3B82F6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <ProgressBar x:Name="ScanProgressBar" Height="12" Minimum="0" Maximum="100" Value="0" Background="#060609" Foreground="#10B981"/>
                        </Grid>

                        <!-- Currently Scanning Item Ticker -->
                        <Border Grid.Row="2" Background="#060609" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CURRENTLY SCANNING:" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="CurrentItemText" Text="Initializing diagnostic engine..." FontSize="12" Foreground="#D1D5DB" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="PercentageText" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#3B82F6" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="3" Text="Real-Time Diagnostic Activity Stream:" FontSize="13" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,8"/>

                        <!-- Live Console Activity Stream -->
                        <Border Grid.Row="4" Background="#060609" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogTextBox" FontFamily="Consolas, Courier New" FontSize="12" Foreground="#10B981" TextWrapping="Wrap" LineHeight="18"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. RESULT PANEL -->
            <Grid x:Name="ResultPanel" Visibility="Collapsed">
                <Border Background="#0F0F17" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="14" Padding="32">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Verdict Badge -->
                        <Border x:Name="VerdictBox" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="VerdictIcon" Text="✅" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="VerdictTitle" Text="SYSTEM VERIFIED CLEAN" FontSize="20" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="VerdictSubtitle" Text="No cheat client artifacts, memory strings, or evasion traces were detected." FontSize="13" Foreground="#A7F3D0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Reference Code Card -->
                        <Border Background="#060609" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Your Reference Code for Server Staff:" FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ReportIdText" Text="ACD-2026-X8K92L" FontSize="30" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                
                                <Button x:Name="CopyCodeButton" Click="CopyCodeButton_Click" Style="{StaticResource GradientButtonStyle}" Content="📋 Copy Reference Code" Width="240" Height="44" FontSize="14"/>
                                <TextBlock x:Name="CopyStatusText" Text="" FontSize="12" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UploadStatusText" Text="✓ Telemetry report successfully transmitted to Sunveil servers." FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Button Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Close Diagnostic Tool" Width="180" Height="40" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. LEGAL TERMS MODAL OVERLAY -->
            <Grid x:Name="LegalTermsModal" Visibility="Collapsed" Background="#CC060609">
                <Border Background="#0F0F17" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="14" Width="680" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Terms of Service &amp; Privacy Policy" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                        <Border Grid.Row="1" Background="#060609" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock TextWrapping="Wrap" Foreground="#D1D5DB" FontSize="12" LineHeight="18">
                                    <Bold Foreground="#10B981">BLUE STYLE DEVELOPMENT — SUNVEIL OVERWATCH EULA</Bold><LineBreak/><LineBreak/>
                                    <Bold>1. Local Diagnostic Inspection</Bold><LineBreak/>
                                    This software performs local, read-only diagnostic checks on your computer to analyze running processes, process RAM strings, Windows execution logs (Prefetch, UserAssist, ShimCache), temporary directories, and Minecraft client installation folders.<LineBreak/><LineBreak/>
                                    <Bold>2. Telemetry Data Upload</Bold><LineBreak/>
                                    Upon scan completion, a diagnostic summary containing an anonymized hardware identifier (HWID), system hostname, operating system details, and detected flag signatures is securely transmitted to Sunveil SMP servers (https://cheat.sunveil.net). No private personal files, documents, passwords, or personal credentials are collected or uploaded.<LineBreak/><LineBreak/>
                                    <Bold>3. Proprietary License &amp; Usage Restrictions</Bold><LineBreak/>
                                    This software is proprietary technology engineered by Blue Style Development (https://bluestyle.dev). Operational rights are strictly granted to Sunveil SMP and Blue Style Development. Third-party commercial deployment on other server networks is strictly prohibited.<LineBreak/><LineBreak/>
                                    By accepting these terms, you consent to the diagnostic scan and secure telemetry report transmission.
                                </TextBlock>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="AcceptTermsModal_Click" Style="{StaticResource GradientButtonStyle}" Content="I Agree &amp; Accept" Width="160" Height="40" Margin="0,0,12,0"/>
                            <Button Click="CloseTermsModal_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Close" Width="100" Height="40"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Text="Sunveil Overwatch Anti-Cheat v1.0 • Engineered by Blue Style Development (bluestyle.dev)" FontSize="12" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </Grid>
</Window>
